{
  "name": "conduktor-language-tools",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm --filter conduktor-console build",
    "package": "pnpm --filter conduktor-console package",
    "test:vscode": "pnpm --filter conduktor-console test:vscode",
    "test:ui": "pnpm --filter conduktor-console test:ui",
    "sync-tools": "pnpm --filter conduktor-console sync-tools",
    "install-local": "pnpm package && node scripts/install-local.mjs",
    "install-zed-dev": "pnpm --filter @conduktor/console-language-server build && node scripts/install-zed-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
