{
  "name": "vscode-conduktor",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm --filter conduktor-console build",
    "package": "pnpm --filter conduktor-console package",
    "test:vscode": "pnpm --filter conduktor-console test:vscode",
    "sync-tools": "pnpm --filter conduktor-console sync-tools",
    "install-local": "pnpm package && code --install-extension packages/extension/dist/conduktor-console.vsix --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
