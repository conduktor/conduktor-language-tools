{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}"],
      // The release workflow runs vsce from extensions/vscode, which lists @vscode/vsce among its devDependencies.
      "ignoreBinaries": ["vsce"],
    },
    "extensions/vscode": {
      "entry": ["src/test/**/*.test.ts", ".vscode-test.mjs", "scripts/*.mjs"],
      // @conduktor/mcp: esbuild bundles the MCP server from its source path, so nothing imports the package by name.
      // @vscode/test-electron: what @vscode/test-cli drives to download and launch VS Code.
      "ignoreDependencies": ["@conduktor/mcp", "@vscode/test-electron"],
      // The conduktor CLI the VS Code suite runs from the PATH when Docker is missing.
      "ignoreBinaries": ["conduktor"],
    },
  },
}
