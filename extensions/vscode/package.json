{
  "name": "conduktor-console",
  "displayName": "Conduktor Console",
  "icon": "resources/icon.png",
  "description": "Explore, write and check Conduktor Console resources as YAML, with the Console's own schema and dry runs.",
  "publisher": "conduktor",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/conduktor/conduktor-language-tools"
  },
  "homepage": "https://www.conduktor.io/product/vscode-zed-extension",
  "bugs": {
    "url": "https://github.com/conduktor/conduktor-language-tools/issues"
  },
  "preview": true,
  "galleryBanner": {
    "color": "#072024",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Linters",
    "Snippets",
    "AI"
  ],
  "keywords": [
    "conduktor",
    "kafka",
    "yaml",
    "gitops",
    "schema registry",
    "infrastructure as code"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onFileSystem:conduktor",
    "onFileSystem:conduktor-edit"
  ],
  "contributes": {
    "configuration": {
      "title": "Conduktor",
      "properties": {
        "conduktor.connections": {
          "type": "array",
          "scope": "application",
          "default": [],
          "markdownDescription": "Console connections. Tokens are kept in VS Code secret storage, never here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "url",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "prod",
                  "dev"
                ],
                "enumDescriptions": [
                  "Never changes the Console: browse, dry run, diff, plan",
                  "Can change the Console: apply, save live documents, delete, after a confirmation"
                ]
              }
            }
          }
        },
        "conduktor.subjects.prettySchema": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Lay a Subject's JSON or Avro schema out over lines when it is opened or synced, so the YAML shows it as a readable block. Schema Registry compares parsed schemas, so the layout never makes a change."
        },
        "conduktor.validation.onOpenAndSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Dry-run Conduktor YAML files against the connection when they are opened and saved, with the results in Problems. Never changes the Console."
        },
        "conduktor.explorer.autoReveal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Select the active editor's resource in the Conduktor Explorer, as `explorer.autoReveal` does for files. Only what the tree already shows: it never switches the cluster or opens the view."
        },
        "conduktor.cli.runner": {
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "path"
          ],
          "default": "auto",
          "markdownDescription": "How Plan and Apply run `ctl`: in Docker (the pinned image), from `conduktor.cli.path`, or `auto` — Docker when it answers, else the path."
        },
        "conduktor.cli.image": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `ctl` image Plan and Apply run in Docker. Empty: the version this extension is built and tested with."
        },
        "conduktor.cli.path": {
          "type": "string",
          "default": "conduktor",
          "markdownDescription": "The `conduktor` CLI to run when Docker is not used."
        }
      }
    },
    "commands": [
      {
        "command": "conduktor.addConnection",
        "title": "Add Connection",
        "category": "Conduktor",
        "icon": "$(plug)"
      },
      {
        "command": "conduktor.removeConnection",
        "title": "Remove Connection",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.switchConnection",
        "title": "Switch Connection",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.showOutput",
        "title": "Show Output",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "Conduktor",
        "icon": "$(refresh)"
      },
      {
        "command": "conduktor.dryRunFile",
        "title": "Dry Run File",
        "category": "Conduktor",
        "icon": "$(beaker)"
      },
      {
        "command": "conduktor.dryRunDocument",
        "title": "Dry Run Resource",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.changeMode",
        "title": "Change Mode",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.newResource",
        "title": "New Resource…",
        "category": "Conduktor",
        "icon": "$(add)"
      },
      {
        "command": "conduktor.applyFile",
        "title": "Apply File",
        "category": "Conduktor",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "conduktor.applyDocument",
        "title": "Apply Resource",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.diffWithLive",
        "title": "Diff with Live",
        "category": "Conduktor",
        "icon": "$(diff)"
      },
      {
        "command": "conduktor.openChanges",
        "title": "Open Changes",
        "category": "Conduktor",
        "icon": "$(git-compare)"
      },
      {
        "command": "conduktor.revealInExplorer",
        "title": "Reveal in Conduktor Explorer",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.copyToWorkspace",
        "title": "Copy to Workspace…",
        "category": "Conduktor",
        "icon": "$(save-as)"
      },
      {
        "command": "conduktor.deleteResource",
        "title": "Delete from Console",
        "category": "Conduktor",
        "icon": "$(trash)"
      },
      {
        "command": "conduktor.copyClaudeCodeConfig",
        "title": "Copy MCP Config for Claude Code",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.showMatches",
        "title": "Show Matches",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.syncEverything",
        "title": "Sync Everything",
        "category": "Conduktor",
        "icon": "$(repo-pull)"
      },
      {
        "command": "conduktor.planEnvironment",
        "title": "Plan Environment with CLI",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.validateFolder",
        "title": "Validate Folder against Console",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.applyEnvironment",
        "title": "Apply Environment with CLI",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.syncLocally",
        "title": "Sync Locally",
        "category": "Conduktor",
        "icon": "$(cloud-download)"
      },
      {
        "command": "conduktor.refreshSync",
        "title": "Refresh Local Changes",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.discardChanges",
        "title": "Discard Local Changes",
        "category": "Conduktor",
        "icon": "$(discard)"
      },
      {
        "command": "conduktor.resyncFromConsole",
        "title": "Re-sync from Console",
        "category": "Conduktor",
        "icon": "$(sync)"
      },
      {
        "command": "conduktor.showRequiredVariables",
        "title": "Show Required Variables",
        "category": "Conduktor"
      },
      {
        "command": "conduktor.showOnlyChanges",
        "title": "Show Only Changes",
        "category": "Conduktor",
        "icon": "$(filter)"
      },
      {
        "command": "conduktor.showAll",
        "title": "Show All Resources",
        "category": "Conduktor",
        "icon": "$(filter-filled)"
      },
      {
        "command": "conduktor.editLocally",
        "title": "Edit Locally",
        "category": "Conduktor",
        "icon": "$(edit)"
      },
      {
        "command": "conduktor.applyAllChanges",
        "title": "Apply All Changes",
        "category": "Conduktor",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "conduktor.applyLocal",
        "title": "Apply",
        "category": "Conduktor",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "conduktor.selectCluster",
        "title": "Select Cluster",
        "category": "Conduktor",
        "icon": "$(server)"
      },
      {
        "command": "conduktor.setSyncFolder",
        "title": "Set Sync Folder…",
        "category": "Conduktor",
        "icon": "$(folder-opened)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conduktor",
          "title": "Conduktor",
          "icon": "resources/conduktor.svg"
        }
      ]
    },
    "views": {
      "conduktor": [
        {
          "id": "conduktor.explorer",
          "name": "Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "conduktor.explorer",
        "contents": "Connect to a Conduktor Console to browse its resources.\n[Add Connection](command:conduktor.addConnection)",
        "when": "!conduktor.hasConnection"
      }
    ],
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Conduktor Console",
        "description": "Connect to a Console, explore its resources, then write, check and apply your first one as YAML.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect to your Console",
            "description": "Give the Console's URL and a personal access token or an admin API key. Start in **prod**: it never changes the Console.\n[Add Connection](command:conduktor.addConnection)",
            "media": {
              "markdown": "walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:conduktor.mode"
            ]
          },
          {
            "id": "explore",
            "title": "Pick a cluster and explore",
            "description": "Open the **Conduktor** view in the activity bar. **Global** holds everything that is not in a cluster; **Select Cluster** picks the cluster the tree shows. Click a resource to open it as YAML.\n[Select Cluster](command:conduktor.selectCluster)",
            "media": {
              "markdown": "walkthrough/explore.md"
            },
            "completionEvents": [
              "onContext:conduktor.cluster"
            ]
          },
          {
            "id": "write",
            "title": "Write a resource",
            "description": "**New Resource…** asks for a kind and builds a document from the Console's schema: required fields filled in, optional ones as comments, parents and a free name set. Completion and hover docs help with the rest.\n[New Resource…](command:conduktor.newResource)",
            "media": {
              "markdown": "walkthrough/write.md"
            },
            "completionEvents": [
              "onCommand:conduktor.newResource"
            ]
          },
          {
            "id": "check",
            "title": "Check it against the Console",
            "description": "Save the file: it is dry-run against the Console, and the answer shows above the resource and in Problems. **Dry Run File** and **Diff with Live**, in the editor's title bar, check it on demand and show what applying it would change. Nothing changes on the Console.",
            "media": {
              "markdown": "walkthrough/check.md"
            },
            "completionEvents": [
              "onCommand:conduktor.dryRunFile",
              "onCommand:conduktor.diffWithLive"
            ]
          },
          {
            "id": "apply",
            "title": "Apply it in dev",
            "description": "Prod never changes the Console. On a Console you build on, run **Change Mode** and pick **Dev**: **Apply** appears above every resource and in the editor's title bar. It dry-runs first, shows what will change and asks before it applies.\n[Change Mode](command:conduktor.changeMode)",
            "media": {
              "markdown": "walkthrough/apply.md"
            },
            "completionEvents": [
              "onCommand:conduktor.applyFile",
              "onCommand:conduktor.applyLocal",
              "onCommand:conduktor.applyAllChanges"
            ]
          },
          {
            "id": "sync",
            "title": "Keep your resources in git (optional)",
            "description": "**Sync Everything** copies the Console's resources into a folder laid out like a GitOps repository, one file per resource, with secrets kept out as placeholders. The tree then marks what is new, edited or changed on the Console.\n[Sync Everything](command:conduktor.syncEverything)",
            "media": {
              "markdown": "walkthrough/sync.md"
            },
            "completionEvents": [
              "onContext:conduktor.syncFolder"
            ]
          },
          {
            "id": "agents",
            "title": "Let AI agents write it (optional)",
            "description": "Copilot and Claude Code get the Console's schema and dry run as tools, so they write YAML the Console accepts. In Copilot's agent mode the tools are ready as soon as you are connected; Claude Code needs the MCP config in the project's .mcp.json file.\n[Copy MCP Config for Claude Code](command:conduktor.copyClaudeCodeConfig)",
            "media": {
              "markdown": "walkthrough/agents.md"
            },
            "completionEvents": [
              "onCommand:conduktor.copyClaudeCodeConfig"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conduktor.selectCluster",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "navigation"
        },
        {
          "command": "conduktor.addConnection",
          "when": "view == conduktor.explorer",
          "group": "navigation"
        },
        {
          "command": "conduktor.refreshExplorer",
          "when": "view == conduktor.explorer",
          "group": "navigation"
        },
        {
          "command": "conduktor.newResource",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "navigation"
        },
        {
          "command": "conduktor.changeMode",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "1_connection"
        },
        {
          "command": "conduktor.copyClaudeCodeConfig",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "2_agents"
        },
        {
          "command": "conduktor.refreshSync",
          "when": "view == conduktor.explorer && conduktor.syncFolder",
          "group": "3_sync"
        },
        {
          "command": "conduktor.showRequiredVariables",
          "when": "view == conduktor.explorer && conduktor.syncFolder",
          "group": "3_sync"
        },
        {
          "command": "conduktor.showOnlyChanges",
          "when": "view == conduktor.explorer && conduktor.syncFolder && !conduktor.onlyChanges",
          "group": "navigation"
        },
        {
          "command": "conduktor.showAll",
          "when": "view == conduktor.explorer && conduktor.onlyChanges",
          "group": "navigation"
        },
        {
          "command": "conduktor.applyAllChanges",
          "when": "view == conduktor.explorer && conduktor.syncFolder && conduktor.mode == dev",
          "group": "navigation"
        },
        {
          "command": "conduktor.syncEverything",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "3_sync"
        },
        {
          "command": "conduktor.setSyncFolder",
          "when": "view == conduktor.explorer && conduktor.mode",
          "group": "3_sync"
        },
        {
          "command": "conduktor.planEnvironment",
          "when": "view == conduktor.explorer && conduktor.syncFolder",
          "group": "3_sync"
        },
        {
          "command": "conduktor.applyEnvironment",
          "when": "view == conduktor.explorer && conduktor.syncFolder && conduktor.mode == dev",
          "group": "3_sync"
        }
      ],
      "commandPalette": [
        {
          "command": "conduktor.showMatches",
          "when": "false"
        },
        {
          "command": "conduktor.syncEverything",
          "when": "conduktor.mode"
        },
        {
          "command": "conduktor.dryRunDocument",
          "when": "false"
        },
        {
          "command": "conduktor.applyDocument",
          "when": "false"
        },
        {
          "command": "conduktor.deleteResource",
          "when": "false"
        },
        {
          "command": "conduktor.copyToWorkspace",
          "when": "resourceScheme =~ /^conduktor(-edit)?$/"
        },
        {
          "command": "conduktor.applyFile",
          "when": "conduktor.mode == dev"
        },
        {
          "command": "conduktor.syncLocally",
          "when": "false"
        },
        {
          "command": "conduktor.refreshSync",
          "when": "conduktor.syncFolder"
        },
        {
          "command": "conduktor.showRequiredVariables",
          "when": "conduktor.syncFolder"
        },
        {
          "command": "conduktor.editLocally",
          "when": "resourceScheme =~ /^conduktor(-edit)?$/"
        },
        {
          "command": "conduktor.applyLocal",
          "when": "false"
        },
        {
          "command": "conduktor.applyAllChanges",
          "when": "conduktor.syncFolder && conduktor.mode == dev"
        }
      ],
      "editor/title": [
        {
          "command": "conduktor.dryRunFile",
          "when": "resourceLangId == yaml && conduktor.mode",
          "group": "navigation"
        },
        {
          "command": "conduktor.applyFile",
          "when": "resourceLangId == yaml && conduktor.mode == dev",
          "group": "navigation"
        },
        {
          "command": "conduktor.copyToWorkspace",
          "when": "resourceScheme =~ /^conduktor(-edit)?$/",
          "group": "navigation"
        },
        {
          "command": "conduktor.editLocally",
          "when": "resourceScheme =~ /^conduktor(-edit)?$/",
          "group": "navigation"
        },
        {
          "command": "conduktor.diffWithLive",
          "when": "resource in conduktor.resourceDocuments",
          "group": "navigation"
        },
        {
          "command": "conduktor.openChanges",
          "when": "resource in conduktor.modifiedFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "conduktor.newResource",
          "when": "view == conduktor.explorer && viewItem =~ /^(kind|parent)$/",
          "group": "inline"
        },
        {
          "command": "conduktor.newResource",
          "when": "view == conduktor.explorer && viewItem =~ /^(kind|parent)$/",
          "group": "1_new"
        },
        {
          "command": "conduktor.copyToWorkspace",
          "when": "view == conduktor.explorer && viewItem == resource",
          "group": "1_copy"
        },
        {
          "command": "conduktor.deleteResource",
          "when": "view == conduktor.explorer && viewItem == resource && conduktor.mode == dev",
          "group": "9_delete"
        },
        {
          "command": "conduktor.syncLocally",
          "when": "view == conduktor.explorer && viewItem =~ /^(kind|parent|resource)/",
          "group": "2_sync"
        },
        {
          "command": "conduktor.discardChanges",
          "when": "view == conduktor.explorer && viewItem == resource.modified",
          "group": "2_sync"
        },
        {
          "command": "conduktor.resyncFromConsole",
          "when": "view == conduktor.explorer && viewItem =~ /^resource\\.(modified|synced)/",
          "group": "2_sync"
        },
        {
          "command": "conduktor.editLocally",
          "when": "view == conduktor.explorer && viewItem == resource && conduktor.syncFolder",
          "group": "inline"
        },
        {
          "command": "conduktor.applyLocal",
          "when": "view == conduktor.explorer && viewItem =~ /^resource\\.(new|modified)$/ && conduktor.mode == dev",
          "group": "inline"
        },
        {
          "command": "conduktor.selectCluster",
          "when": "view == conduktor.explorer && viewItem == scope.cluster",
          "group": "inline"
        }
      ],
      "editor/title/context": [
        {
          "command": "conduktor.revealInExplorer",
          "when": "resource in conduktor.resourceDocuments",
          "group": "2_files"
        }
      ],
      "editor/context": [
        {
          "command": "conduktor.revealInExplorer",
          "when": "resource in conduktor.resourceDocuments",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "conduktor.revealInExplorer",
          "when": "resource in conduktor.syncFiles",
          "group": "navigation"
        },
        {
          "command": "conduktor.validateFolder",
          "when": "explorerResourceIsFolder && conduktor.mode",
          "group": "7_modification"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "conduktor_list_kinds",
        "displayName": "List Conduktor kinds",
        "modelDescription": "List the Conduktor Console resource kinds the connected Console accepts (for example Topic, Application, KafkaCluster) with their apiVersions, API group, the metadata fields that name their parents (such as cluster) and the order they are applied in. Call this first when you are not sure which kind to use.",
        "userDescription": "List Conduktor kinds",
        "toolReferenceName": "conduktorListKinds",
        "canBeReferencedInPrompt": true,
        "tags": [
          "conduktor",
          "kafka"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "conduktor_get_kind_schema",
        "displayName": "Get Conduktor kind schema",
        "modelDescription": "Get the JSON Schema and an example YAML for one Conduktor Console resource kind on the connected Console. Call this before writing or editing a resource of that kind and follow it exactly: Conduktor resources look like Kubernetes YAML but their fields are Conduktor-specific.",
        "userDescription": "Get Conduktor kind schema",
        "toolReferenceName": "conduktorGetKindSchema",
        "canBeReferencedInPrompt": true,
        "tags": [
          "conduktor",
          "kafka"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "description": "The resource kind, for example Topic."
            },
            "apiVersion": {
              "type": "string",
              "description": "A version such as v2. Defaults to the latest."
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      {
        "name": "conduktor_validate",
        "displayName": "Validate Conduktor YAML",
        "modelDescription": "Validate Conduktor Console resource YAML against the connected Console's schema, without contacting the Console. Pass the YAML text or a workspace file path. Returns, for each resource, the schema errors with their JSON paths. Run it after writing or changing a resource, fix every error, then use conduktor_dry_run.",
        "userDescription": "Validate Conduktor YAML",
        "toolReferenceName": "conduktorValidate",
        "canBeReferencedInPrompt": true,
        "tags": [
          "conduktor",
          "kafka"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "yaml": {
              "type": "string",
              "description": "Conduktor resource YAML; several resources may be separated by ---."
            },
            "path": {
              "type": "string",
              "description": "A YAML file in the workspace, relative to its root. Use instead of yaml."
            }
          }
        }
      },
      {
        "name": "conduktor_dry_run",
        "displayName": "Dry-run Conduktor YAML",
        "modelDescription": "Dry-run Conduktor Console resource YAML on the connected Console: the Console checks it (ownership, policies, references) and reports whether each resource would be Created, Updated or NotChanged, or why it would fail. Nothing is applied and the Console does not change. Pass the YAML text or a workspace file path. After a clean dry run, tell the user it is ready and that they apply it from the editor; never say it has been applied.",
        "userDescription": "Dry-run Conduktor YAML",
        "toolReferenceName": "conduktorDryRun",
        "canBeReferencedInPrompt": true,
        "tags": [
          "conduktor",
          "kafka"
        ],
        "inputSchema": {
